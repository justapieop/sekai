RUST_LOG="info" # Log level

HOST="127.0.0.1:3000" # Host URL

MACHINE_ID=1836 # Machine ID for snowflake ID generation (must be an unsigned 32 bit integer)

JWKS_URL="" # JSON Web Key Set URL
JWKS_ISS="" # JSON Web Key Set issuer
DATABASE_URL="" # PostgreSQL database URL

S3_REGION="" # S3 region
S3_ENDPOINT="" # S3 API endpoint (not to be confused with S3 file URL)
S3_ACCESS_KEY_ID="" # S3 access key ID
S3_SECRET_ACCESS_KEY="" # S3 secret key